              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "executor.queryTasks"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "cursor": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "executor.queryRuns"
