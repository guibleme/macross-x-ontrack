{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macross-connectors-v1",
  "title": "Macross transport-independent connector request v1",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
