                  "actor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "scopeDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "actor",
                  "scopeDigest"
                ],
                "additionalProperties": false
              },
              "payload": {
                "type": "object"
              }
            },
            "required": [
              "operationId",
              "target",
              "expectedRevision",
              "payloadDigest",
              "approval",
              "payload"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "executor.reconcile"
