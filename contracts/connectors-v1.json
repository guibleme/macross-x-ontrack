        "source.test",
        "source.snapshot",
        "executor.queryTasks",
        "executor.queryRuns",
        "executor.submitApproved",
        "executor.reconcile",
        "session.start",
        "session.send",
        "session.observe",
        "intelligence.propose",
        "session.interrupt",
        "session.resume"
