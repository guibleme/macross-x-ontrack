                "maxLength": 4096
              }
            },
            "required": [
              "providerRef"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "intelligence.propose"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "context": {
                "$ref": "#/$defs/context"
              },
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              }
            },
            "required": [
              "context",
              "intent"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.interrupt"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "providerRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "providerRef"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "session.resume"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "providerRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "agentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "context": {
                "$ref": "#/$defs/context"
              }
            },
            "required": [
              "providerRef",
              "agentId",
              "context"
            ],
            "additionalProperties": false
          }
        }
      }
    }
