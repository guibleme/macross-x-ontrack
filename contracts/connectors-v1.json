  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nativeRecordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "instanceId",
        "nativeRecordId",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "frontId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 64
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "required": [
        "frontId",
        "revision",
        "evidence",
        "content",
        "digest",
        "coverage"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "complete",
        "included",
        "total"
      ],
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nativeRecordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "nativeStatus": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sourceUpdatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "instanceId",
        "nativeRecordId",
        "revision",
        "nativeStatus",
        "sourceUpdatedAt",
        "observedAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "nativeRecordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "instanceId",
              "nativeRecordId",
              "revision",
              "digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "coverage": {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "included": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "complete",
            "included",
            "total"
          ],
          "additionalProperties": false
        },
        "executionAuthorized": {
          "const": false
        }
      },
      "required": [
        "id",
        "text",
        "evidence",
        "coverage",
        "executionAuthorized"
      ],
      "additionalProperties": false
    }
  },
  "protocolVersion": 1,
  "limits": {
    "records": 256,
    "contextBytes": 262144,
    "outputBytes": 262144,
    "inputBytes": 32768,
    "proposalBytes": 65536
  },
  "requiredOperations": {
    "source": [
      "source.describe",
      "source.validateConfig",
      "source.test",
      "source.snapshot"
    ],
    "executor": [
      "executor.queryTasks",
      "executor.queryRuns",
      "executor.submitApproved",
      "executor.reconcile"
    ],
    "session": [
      "session.start",
      "session.send",
      "session.observe"
    ],
    "intelligence": [
      "intelligence.propose"
    ]
  },
  "operations": {
    "source.describe": {
      "kind": "source",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": "Versioned descriptor, declared capabilities and configuration fields."
    },
    "source.validateConfig": {
      "kind": "source",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object"
          }
        },
        "required": [
          "config"
        ],
        "additionalProperties": false
      },
      "result": "Validation errors and credentialConfigured flags. Never return credential values."
    },
    "source.test": {
      "kind": "source",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": "Bounded health observation with lastSuccessfulReadAt and sanitized error. No task creation, repair or dispatch."
    },
    "source.snapshot": {
      "kind": "source",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "records[] of sourceRecord, coverage, cursor and source health. Partial reads never prove deletion."
    },
    "executor.queryTasks": {
      "kind": "executor",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "Native task identities, revisions, fields, coverage and cursor. Caches never replace the source authority."
    },
    "executor.queryRuns": {
      "kind": "executor",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 256
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "Native run identities, task links, active identity, state, resultRevision and current acceptance validity."
    },
    "executor.submitApproved": {
      "kind": "executor",
      "readOnly": false,
      "params": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedRevision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "payloadDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "scopeDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "actor",
              "scopeDigest"
            ],
            "additionalProperties": false
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "operationId",
          "target",
          "expectedRevision",
          "payloadDigest",
          "approval",
          "payload"
        ],
        "additionalProperties": false
      },
      "result": "Durable operation identity and confirmed, failed or unknown outcome. Persist intent before effects."
    },
    "executor.reconcile": {
      "kind": "executor",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "operationId"
        ],
        "additionalProperties": false
      },
      "result": "Authoritative operation outcome and evidence. This read never blindly replays the original mutation."
    },
    "session.start": {
      "kind": "session",
      "readOnly": false,
      "params": {
        "type": "object",
        "properties": {
          "frontId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "context": {
            "$ref": "#/$defs/context"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "frontId",
          "agentId",
          "context",
          "input"
        ],
        "additionalProperties": false
      },
      "result": "Opaque providerRef, selected agent identity and submission status. No implicit Bead or worktree."
    },
    "session.send": {
      "kind": "session",
      "readOnly": false,
      "params": {
        "type": "object",
        "properties": {
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "context": {
            "$ref": "#/$defs/context"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "providerRef",
          "context",
          "input"
        ],
        "additionalProperties": false
      },
      "result": "Submission receipt. Context and history remain owned by the front."
    },
    "session.observe": {
      "kind": "session",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        },
        "required": [
          "providerRef"
        ],
        "additionalProperties": false
      },
      "result": "Pending or answered result, bounded text, cursor and evidence. Preserve full admitted output."
    },
    "intelligence.propose": {
      "kind": "intelligence",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "context": {
            "$ref": "#/$defs/context"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "context",
          "intent"
        ],
        "additionalProperties": false
      },
      "result": "Proposal with evidence references and explicit coverage. It grants no execution or acceptance authority."
    },
    "session.interrupt": {
      "kind": "session",
      "readOnly": false,
      "optional": true,
      "params": {
        "type": "object",
        "properties": {
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "providerRef"
        ],
        "additionalProperties": false
      },
      "result": "Requested or confirmed interruption. A request is not proof that work stopped."
    },
    "session.resume": {
      "kind": "session",
      "readOnly": false,
      "optional": true,
      "params": {
        "type": "object",
        "properties": {
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "context": {
            "$ref": "#/$defs/context"
